<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_lowest"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/logo_nutridiet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NutriDiet"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/act_sub"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotifAct"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifikasi Pengingat"
            android:src="@drawable/ic_notif" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_avatar" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tanggal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_today"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/act_today_badge"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/actStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/act21" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sen\n21" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <Button android:id="@+id/act22" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sel\n22" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <Button android:id="@+id/act23" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Rab\n23" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <Button android:id="@+id/act24" android:layout_width="56dp" android:layout_height="68dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_btn_primary" android:backgroundTint="@null" android:text="Kam\n24" android:textColor="@color/on_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/act25" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Jum\n25" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <Button android:id="@+id/act26" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sab\n26" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <Button android:id="@+id/act27" android:layout_width="52dp" android:layout_height="64dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Min\n27" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Hero langkah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_fitness" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="6dp" android:text="@string/act_steps_title" android:textColor="@color/on_surface" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_steps_badge" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout android:layout_width="150dp" android:layout_height="150dp">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ringSteps"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:progress="74"
                            app:indicatorColor="@color/primary"
                            app:indicatorSize="150dp"
                            app:trackColor="@color/surface_container"
                            app:trackThickness="14dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvSteps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_steps_value" android:textColor="@color/on_surface" android:textSize="26sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_steps_target" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/act_steps_left" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_field" android:orientation="horizontal" android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_cal_burn" android:textColor="@color/tertiary_container" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_cal_burn_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_minutes" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_minutes_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_distance" android:textColor="@color/secondary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_distance_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Konsistensi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_consistency_label" android:textColor="@color/on_surface_variant" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_consistency_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_consistency_badge" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_btn_primary" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_btn_primary" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_btn_primary" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_btn_primary" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_btn_primary" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_field" />
                    <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:background="@drawable/bg_field" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/act_consistency_note" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
            </LinearLayout>

            <!-- Sync banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_card" android:padding="6dp" android:src="@drawable/ic_devices" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_sync_title" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_sync_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_sync_badge" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Log gerak -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/act_log_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnActHistory" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="@string/act_history" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_field" android:padding="10dp" android:src="@drawable/ic_fitness" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_jog" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_jog_info" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_done" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_field" android:padding="10dp" android:src="@drawable/ic_health" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_stretch" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_stretch_info" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_done" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_field" android:padding="10dp" android:src="@drawable/ic_progress" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_walk" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_walk_info" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/act_scheduled" android:textColor="@color/on_surface_variant" android:textSize="10sp" />
                </LinearLayout>
                <Button android:id="@+id/btnStartNow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="@string/act_start_now" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Rekomendasi -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_rec_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_rec_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                </LinearLayout>
                <Button android:id="@+id/btnExplore" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="@string/act_explore" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_fire" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Intensitas Sedang • +160 kkal" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="HIIT Pembakar Lemak" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 Menit • Tanpa Alat" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                        <Button android:id="@+id/btnSesi1" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_btn_primary" android:backgroundTint="@null" android:text="Mulai Sesi" android:textAllCaps="false" android:textColor="@color/on_primary" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_eco" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Ramah Pemula" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Yoga &amp; Mobilitas Perut" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 Menit • Metabolisme" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                        <Button android:id="@+id/btnSesi2" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Mulai Sesi" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_balance" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Kardio Ringan • +110 kkal" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tabata Core Cepat" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 Menit • Otot Inti" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                        <Button android:id="@+id/btnSesi3" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Mulai Sesi" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnLogManual"
                android:layout_width="match_parent"
                android:layout_height="52dp"
