<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_lowest"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/logo_nutridiet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NutriDiet"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutri_sub"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotifNutri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifikasi Pengingat"
            android:src="@drawable/ic_notif" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_avatar" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Kalender -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nutri_month"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnToday"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_field"
                        android:backgroundTint="@null"
                        android:text="@string/nutri_today"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/calendarStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/day22" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sen\n22" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <Button android:id="@+id/day23" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sel\n23" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <Button android:id="@+id/day24" android:layout_width="56dp" android:layout_height="68dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_btn_primary" android:backgroundTint="@null" android:text="Rab\n24" android:textColor="@color/on_primary" android:textSize="12sp" android:textStyle="bold" />
                        <Button android:id="@+id/day25" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Kam\n25" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <Button android:id="@+id/day26" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Jum\n26" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <Button android:id="@+id/day27" android:layout_width="52dp" android:layout_height="64dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Sab\n27" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <Button android:id="@+id/day28" android:layout_width="52dp" android:layout_height="64dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Min\n28" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Hero kalori -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/nutri_hero_badge" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nutri_hero_title" android:textColor="@color/on_surface" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvNutriLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_hero_sub" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ringNutri"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:progress="67"
                            app:indicatorColor="@color/primary_container"
                            app:indicatorSize="72dp"
                            app:trackColor="@color/surface_container"
                            app:trackThickness="7dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="67%"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_field"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutri_total_label" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/tvNutriTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_total_value" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="4dp" android:text="@string/nutri_total_target" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/barNutri"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:max="1850"
                        android:progress="1240"
                        style="?android:attr/progressBarStyleHorizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Makro 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutri_macro_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_macro_std" android:textColor="@color/primary" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_carbo" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/home_carbo_value" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <ProgressBar android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="66" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_carbo_pct" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_protein" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/home_protein_value" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <ProgressBar android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="77" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_protein_pct" android:textColor="@color/secondary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lemak Baik" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/home_fat_value" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <ProgressBar android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="69" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_fat_pct" android:textColor="@color/tertiary_container" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_fiber" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="26/30g" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <ProgressBar android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="87" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="87%" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Rencana makan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_plan_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_plan_sub" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="@string/nutri_history" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_field" android:padding="8dp" android:src="@drawable/ic_apple" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sarapan Pagi • 07:30 WIB" android:textColor="@color/outline" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_meal1_name" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="340 kkal • K: 48g P: 11g L: 6g" android:textColor="@color/outline" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_field" android:padding="8dp" android:src="@drawable/ic_restaurant" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Makan Siang • 12:45 WIB" android:textColor="@color/outline" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dada Ayam &amp; Quinoa Salad" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="520 kkal • K: 52g P: 46g L: 14g" android:textColor="@color/outline" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_field" android:padding="8dp" android:src="@drawable/ic_eco" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camilan Sore • 16:15 WIB" android:textColor="@color/outline" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_meal3_name" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="180 kkal • K: 21g P: 4g L: 9g" android:textColor="@color/outline" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_field" android:padding="8dp" android:src="@drawable/ic_balance" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Makan Malam" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_dinner_target" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/nutri_dinner_pending" android:textColor="@color/on_surface_variant" android:textSize="10sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_ai_label" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_card" android:padding="6dp" android:src="@drawable/ic_restaurant" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_dinner_rec_name" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_dinner_rec_info" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <Button android:id="@+id/btnDinnerSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_btn_primary" android:backgroundTint="@null" android:text="@string/nutri_dinner_cta" android:textAllCaps="false" android:textColor="@color/on_primary" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Banner pindai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_card" android:padding="10dp" android:src="@drawable/ic_devices" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_scan_title" android:textColor="@color/on_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_scan_sub" android:textColor="@color/on_primary" android:textSize="11sp" />
                </LinearLayout>
                <Button android:id="@+id/btnScan" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_card" android:backgroundTint="@null" android:text="@string/nutri_scan_btn" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Resep -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_recipe_title" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_recipe_sub" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btnSeeAll" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="@string/nutri_see_all" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_eco" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Tinggi Serat" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Smoothies Hijau Detox" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="150 kkal • 10 mnt" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                            <Button android:id="@+id/btnRecipe1" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Lihat Resep" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_apple" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Tinggi Protein" android:textColor="@color/secondary" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Salad Caesar Rendah Lemak" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="320 kkal • 15 mnt" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                            <Button android:id="@+id/btnRecipe2" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Lihat Resep" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="12dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/bg_field" android:padding="20dp" android:src="@drawable/ic_restaurant" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Vegan" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sup Jamur Bening &amp; Tahu" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="210 kkal • 20 mnt" android:textColor="@color/on_surface_variant" android:textSize="11sp" />
                            <Button android:id="@+id/btnRecipe3" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="Lihat Resep" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Air mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_field" android:padding="10dp" android:src="@drawable/ic_fitness" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_water_title" android:textColor="@color/on_surface" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvWaterMini" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutri_water_mini" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <ProgressBar android:id="@+id/barWaterMini" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:max="2200" android:progress="1750" style="?android:attr/progressBarStyleHorizontal" />
                </LinearLayout>
                <Button android:id="@+id/btnWaterMini" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_field" android:backgroundTint="@null" android:text="+" android:textColor="@color/primary" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/surface_lowest"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:alpha="0.6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_home" android:textSize="11sp" android:textColor="@color/on_surface_variant" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navNutrition" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <LinearLayout android:layout_width="48dp" android:layout_height="28dp" android:background="@drawable/bg_field" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_restaurant" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_nutrition" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_monitoring" android:alpha="0.6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_activity" android:textSize="11sp" android:textColor="@color/on_surface_variant" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person" android:alpha="0.6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_profile" android:textSize="11sp" android:textColor="@color/on_surface_variant" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings" android:alpha="0.6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_settings" android:textSize="11sp" android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
